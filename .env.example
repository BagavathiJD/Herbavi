# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Used for product image links in low stock alert emails
APP_URL=http://localhost:3000

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
# DB_DATABASE=herbavi
DB_DATABASE=herbavi

# JWT secret for admin login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Low stock email alerts (sent when product stock drops below threshold)
LOW_STOCK_EMAIL_ENABLED=false
LOW_STOCK_NOTIFY_EMAIL=admin@example.com
LOW_STOCK_THRESHOLD=10

# SMTP settings for outgoing mail (Gmail, SendGrid, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Herbavi Alerts <your-email@gmail.com>"

# Low stock WhatsApp alerts via CallMeBot (free — https://www.callmebot.com/blog/free-api-whatsapp-messages/)
LOW_STOCK_WHATSAPP_ENABLED=false
LOW_STOCK_WHATSAPP_TO=7806858606
CALLMEBOT_API_KEY=your-callmebot-api-key
